# 로컬 Postgres(docker-compose.yml). 운영 주소는 여기에 넣지 않는다(README "운영 DB")
DATABASE_URL=
DIRECT_URL=

# 비워 두면 AI는 결정적 모의 응답(mock)으로 동작한다
ANTHROPIC_API_KEY=

# 소셜 로그인. 비워 두면 개발 모드에서만 앱 안의 가짜 로그인 화면을 쓴다(README "소셜 로그인")
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 앱 껍데기의 카카오톡 앱 로그인: 받은 토큰이 이 앱 것인지 확인하는 앱 ID(숫자). 없으면 앱도 Safari 로그인 창으로 연다
KAKAO_APP_ID=
# 탈퇴할 때 카카오 연결 끊기(어드민 키). 비우면 끊지 않고 우리 쪽 기록만 지운다
KAKAO_ADMIN_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: Services ID, 팀 ID, Sign in with Apple 키의 ID와 .p8 내용(줄바꿈은 \n으로 한 줄에). 넷 다 있어야 켜진다
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# 공급자 콘솔에 등록한 주소의 앞부분. 비우면 요청 주소를 쓴다
APP_URL=
# 스케줄러(/api/cron/tick) 보호용. 운영에서는 꼭 넣는다. 비우면 개발 모드에서만 열린다
CRON_SECRET=
# 실제 폰에서 맥의 개발 서버를 열 때 그 호스트 이름(예: 192.168.0.10). 쉼표로 여러 개
DEV_ORIGINS=

# 푸시 발송기. 비우면 운영은 expo, 개발·E2E는 mock(밖으로 보내지 않음)
PUSH_SENDER=
# Expo 대시보드에서 푸시 "향상된 보안"을 켰을 때만 필요(expo.dev > Access tokens)
EXPO_ACCESS_TOKEN=
